# Any OpenAI-compatible endpoint. Defaults target NUS SoCLaaS.
LLM_BASE_URL=
# Default chosen from the 24-item perception eval (corpus/eval/perception.yaml):
#   qwen3.6:35b  accuracy 1.00 (ATC 1.00 / PILOT 1.00 / GROUND 1.00), citations 1.00, ~2.1 s/item
#   x-test-4     accuracy 0.96 (ATC 1.00 / PILOT 0.88 / GROUND 1.00), citations 1.00, ~1.3 s/item
#   x-test-2     accuracy 0.92 (ATC 0.88 / PILOT 1.00 / GROUND 0.88), citations 0.83, ~16 s/item
LLM_MODEL=qwen3.6:35b
# Optional per-role overrides (fall back to LLM_MODEL). Eval tie-break suggests
# x-test-4 for ATC/GROUND (1.00 accuracy, ~1.3-1.6 s/item) and qwen3.6:35b for PILOT.
# LLM_MODEL_ATC=x-test-4
# LLM_MODEL_PILOT=qwen3.6:35b
# LLM_MODEL_GROUND=x-test-4
# LLM_API_KEY falls back to SOCLAAS_API_KEY if unset
LLM_API_KEY=
LLM_TIMEOUT_S=90
LLM_CACHE=1
